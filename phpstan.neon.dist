includes:
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - src
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true

    ignoreErrors:
        # Schema commands and columns are Fluent objects with magic attributes.
        -
            identifier: property.notFound
            message: '#Illuminate\\Support\\Fluent#'
