{
    "name": "vuthaihoc/cockroachdb-laravel",
    "description": "A CockroachDB database driver for Laravel: query and schema grammars, connector and Eloquent support (fork of ylsideas/cockroachdb-laravel)",
    "keywords": [
        "ylsideas",
        "laravel",
        "cockroachdb-laravel",
        "cockroachdb"
    ],
    "homepage": "https://github.com/vuthaihoc/crdb2025",
    "license": "MIT",
    "authors": [
        {
            "name": "Peter Fox",
            "email": "peter.fox@ylsideas.co",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.9.2",
        "vuthaihoc/laravel-db-portable": "^0.7"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.17",
        "laravel/scout": "^11.8",
        "nunomaduro/collision": "^8.1",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "suggest": {
        "vuthaihoc/laravel-matrixone": "MatrixOne driver, for moving an application from CockroachDB to MatrixOne",
        "laravel/scout": "Full-text, fuzzy, semantic and hybrid search with SCOUT_DRIVER=crdb (Scout 11.8+)"
    },
    "autoload": {
        "psr-4": {
            "YlsIdeas\\CockroachDb\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YlsIdeas\\CockroachDb\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest coverage",
        "lint": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "YlsIdeas\\CockroachDb\\CockroachDbServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
